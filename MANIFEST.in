include LICENSE README.md pyproject.toml uv.lock .python-version .gitattributes BOLT-HANDOFF.md
include VENDORED.md
recursive-include src/screenshot_memory *.py
include src/screenshot_memory/shared/vindex/migrations/001_initial.sql
include src/screenshot_memory/shared/vindex/migrations/002_unicode_fts.sql
include src/screenshot_memory/shared/vindex/migrations/003_import_staging.sql
include src/screenshot_memory/shared/docio/schema.json
include src/screenshot_memory/shared/docio/README.md
include src/screenshot_memory/shared/evalkit/schema.json
include src/screenshot_memory/shared/evalkit/README.md
recursive-include scripts *.py
recursive-include tests *.py
recursive-include contracts *.json *.md
recursive-include docs *.md
include web/package.json
include web/src/model.ts
include web/tests/model.test.ts
prune .git
prune .venv
prune .creds
prune .agent-registry
prune .agent-work
prune .chatexports
prune .thinking
prune planning
prune agentops
prune build
prune dist
global-exclude __pycache__ *.py[cod] .env .env.* *.log *.jsonl *.png *.jpg *.jpeg *.webp *.gif *.sqlite* *.db *.onnx *.safetensors *.pt

