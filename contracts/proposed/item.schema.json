{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "PROPOSAL ONLY. Raw source hash and processing revision are separate; no OCR/Pointer wire is defined here.",
  "title": "S7ItemProposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "item_id", "collection_id", "original_content_sha256", "revision", "generation", "state"],
  "properties": {
    "schema_version": {"const": 1},
    "item_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "collection_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "original_content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "revision": {"type": "integer", "minimum": 0},
    "generation": {"type": "integer", "minimum": 0},
    "state": {"enum": ["pending", "partial", "ready", "failed", "deleting"]}
  }
}
